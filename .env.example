NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: better copy and image moderation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: live payments. Without these, account holders can use demo checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EXPORT=
STRIPE_PRICE_MEMBERSHIP=
STRIPE_PRICE_HOSTED_LOGIN=
STRIPE_PRICE_DEPLOY=

# Sign-up codes and finished-page links. Without RESEND_API_KEY, a copy is written to data/outbox/.
RESEND_API_KEY=
MAIL_FROM=PageBuilder <noreply@localhost>

# Optional: shared secret for POST /api/cleanup (also runs when /api/me loads).
CLEANUP_SECRET=
